# ==============================================================================
# RAG Chatbot Environment Configuration
# ==============================================================================
# Copy this file to .env and adjust variables as needed for your local setup.
# None of your private API keys should ever be committed to version control.

# --- LLM Provider Selection ---
# Options: "ollama" (local, open-source, recommended) or "openai" (cloud API)
LLM_PROVIDER=ollama

# --- Ollama Configuration (Local Inference) ---
# Default Ollama server address
OLLAMA_BASE_URL=http://localhost:11434
# Fast, high-quality models: llama3.2, llama3.1, mistral, phi3
OLLAMA_MODEL=llama3.2
# Request timeout in seconds
OLLAMA_REQUEST_TIMEOUT=120.0

# --- OpenAI Configuration (Optional Cloud Inference) ---
# Required ONLY if LLM_PROVIDER=openai or EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# --- Embedding Configuration ---
# Options: "huggingface" (local sentence-transformers), "ollama", or "openai"
EMBEDDING_PROVIDER=huggingface
# Sentence-Transformers model running locally on CPU/GPU
HUGGINGFACE_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Ollama embedding model (run: ollama pull nomic-embed-text)
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# OpenAI embedding model
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- ChromaDB Vector Store ---
CHROMA_PERSIST_DIRECTORY=./chroma_db
DEFAULT_COLLECTION_NAME=rag_knowledge_base

# --- Document Chunking Settings ---
# Size of text chunks in characters
CHUNK_SIZE=800
# Character overlap between consecutive chunks to preserve contextual boundaries
CHUNK_OVERLAP=150

# --- Retrieval Settings ---
# Number of most relevant chunks to return for each query
TOP_K=4
# Minimum cosine similarity threshold (range 0.0 to 1.0; 0.0 disables threshold)
SIMILARITY_THRESHOLD=0.35
# Hybrid search combines dense vector search with sparse BM25 keyword search
ENABLE_HYBRID_SEARCH=true
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3

# --- Document Upload & Security ---
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=.pdf,.txt,.docx

# --- Application Logging ---
# DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
